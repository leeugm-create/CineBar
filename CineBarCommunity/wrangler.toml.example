name = "cinebar-community"
main = "worker.js"
compatibility_date = "2026-07-01"

[[d1_databases]]
binding = "DB"
database_name = "cinebar-community"
database_id = "REPLACE_WITH_D1_DATABASE_ID"

[assets]
directory = "./public"

# 可选：部署后使用 `wrangler secret put PUBLIC_KEY` 设置公开访问 Key。
# 它不是用户密码，真正的防滥用仍依赖服务端校验、限频与举报机制。
