{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cinebar-telemetry-test",
  "main": "worker.js",
  "compatibility_date": "2026-08-03",
  "routes": [
    {
      "pattern": "telemetry.cinebar.cc",
      "custom_domain": true
    }
  ],
  "secrets": {
    "required": [
      "TELEMETRY_ADMIN_TOKEN"
    ]
  },
  "vars": {
    "CINEBAR_RELEASE_VERSION": "0.8.3-test.10",
    "TELEMETRY_ADMIN_TOKEN": "__SET_VIA_DEPLOY_VAR__"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cinebar-telemetry-test",
      "database_id": "e2375126-0eef-4d77-af18-9131498be4e1"
    }
  ]
}