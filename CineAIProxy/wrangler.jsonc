{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cineai-proxy",
  "main": "worker.js",
  "compatibility_date": "2026-07-25",
  "routes": [
    { "pattern": "cineai.cinebar.cc", "custom_domain": true }
  ],
  "secrets": {
    "required": ["DEEPSEEK_API_KEY"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cineai-proxy",
      "database_id": "8aa61595-30de-4614-8d9f-0c78287fe525"
    }
  ]
}
